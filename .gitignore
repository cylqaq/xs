# Dependencies
node_modules/
.pnpm-store/

# Logs & debug
*.log
npm-debug.log*
pnpm-debug.log*

# Environment & secrets
.env
.env.*
!.env.example

# OS
.DS_Store
Thumbs.db
Desktop.ini

# IDE / editor
.idea/
.vscode/
*.swp
*.swo
*~

# Local workspace (per-user; commit *.example only)
workspace/user-preferences.json

# Smoke test ephemeral novels (generated by pnpm smoke:*)
stories/_smoke-*/

# Per-novel runtime / agent working state (keep template dir skeleton only)
stories/*/state/working/**
!stories/*/state/working/**/
!stories/*/state/working/**/.gitkeep

# Optional: real novels with local-only drafts (uncomment when needed)
# stories/my-*/

# Build / cache
dist/
.cache/
coverage/
